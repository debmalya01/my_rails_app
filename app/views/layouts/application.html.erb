<!doctype html>
<html lang="ar">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag "api_auth", "data-turbo-track": "reload", defer: true %>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.rtl.min.css" integrity="sha384-Xbg45MqvDIk1e563NLpGEulpX6AvL404DP+/iCgW9eFa2BqztiwTexswJo2jLMue" crossorigin="anonymous">

    <!-- Custom CSS for larger navbar -->
    <style>
      .navbar {
        padding: 0.75rem 0;
      }
      .navbar-brand {
        font-size: 1.75rem;
      }
      .navbar-nav .nav-link {
        font-size: 1.1rem;
        padding: 0.75rem 1rem;
      }
      .dropdown-item {
        font-size: 1rem;
        padding: 0.75rem 1.5rem;
      }
      .avatar-dropdown {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #007bff, #0056b3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1.2rem;
        cursor: pointer;
        border: 2px solid #dee2e6;
        transition: all 0.2s ease;
      }
      .avatar-dropdown:hover {
        border-color: #007bff;
        transform: scale(1.05);
      }
      .dropdown-header {
        font-weight: bold;
        color: #495057;
        font-size: 0.9rem;
      }
    </style>

    <title>Mechanico</title>
    
  </head>
  <body>
    <!-- Flash messages -->
    <% if notice %>
      <div class="alert alert-success text-center"><%= notice %></div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger text-center"><%= alert %></div>
    <% end %>


    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
      <div class="container-fluid">
        <%= link_to "Mechanico", root_path, class: "navbar-brand fw-bold text-primary" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" 
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
            <li class="nav-item">
              <%= link_to "Home", root_path, class: "nav-link text-primary", aria: { current: "page" } %>
            </li>
            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link text-primary" %>
            </li>
            <% if user_signed_in? %>
              <% if current_user.car_owner? %>
                <li class="nav-item dropdown">
                  <a class="nav-link d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="avatar-dropdown">
                      <%= current_user.name.first.upcase %>
                    </div>
                  </a>
                  <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <li><h6 class="dropdown-header"><%= current_user.name %></h6></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><%= link_to "My Cars", cars_path, class: "dropdown-item" %></li>
                    <li><%= link_to "Booking History", booking_history_path, class: "dropdown-item" %></li>
                  </ul>
                </li>
              <% elsif current_user.garage_admin? %>
                <li class="nav-item dropdown">
                  <a class="nav-link d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="avatar-dropdown">
                      <%= current_user.name.first.upcase %>
                    </div>
                  </a>
                  <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <li><h6 class="dropdown-header"><%= current_user.name %></h6></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><%= link_to "My Garage", garages_path, class: "dropdown-item" %></li>
                  </ul>
                </li>
              <% end %>
            <% end %>
          </ul>
          
          <!-- User section in navbar -->
          <div class="d-flex align-items-center">
            <% if user_signed_in? %>
              <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-danger" %>
              <%= javascript_tag do %>
                document.addEventListener('DOMContentLoaded', function() {
                  var logoutButton = document.querySelector('form[action*="sign_out"]');
                  if (logoutButton) {
                    logoutButton.addEventListener('submit', function() {
                      sessionStorage.removeItem('access_token');
                      localStorage.removeItem('access_token')
                    });
                  }
                });
              <% end %>
            <% else %>
              <%= link_to 'Login', new_user_session_path, class: "btn btn-sm btn-outline-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>


    <!-- Optional JavaScript; choose one of the two! -->

    <!-- Option 1: Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>

    <!-- Option 2: Separate Popper and Bootstrap JS -->
    <!--
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js" integrity="sha384-7qAoOXltbVP82dhxHAUje59V5r2YsVfBafyUDxEdApLPmcdhBPg1DKg1ERo0BZlK" crossorigin="anonymous"></script>
    -->

    <%= yield %>
  </body>
</html>
