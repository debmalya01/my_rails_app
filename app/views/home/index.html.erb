<!-- Hero Section -->
<section class="py-5 text-center" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); min-height: 60vh; display: flex; align-items: center;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h1 class="display-3 fw-bold text-primary mb-4">Welcome to Mechanico</h1>
        <p class="lead text-muted mb-5" style="font-size: 1.3rem; line-height: 1.6;">
          Your trusted platform for seamless vehicle management and garage operations. 
          Experience the future of automotive service booking.
        </p>

        <% unless user_signed_in? %>
          <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mb-4">
            <%= link_to new_user_registration_path(type: "CarOwner"), class: "btn btn-lg btn-primary px-5 py-3 shadow-sm", style: "border-radius: 50px; font-weight: 600;" do %>
              <i class="fas fa-car me-2"></i>I'm a Car Owner
            <% end %>
            <%= link_to new_user_registration_path(type: "GarageAdmin"), class: "btn btn-lg btn-outline-primary px-5 py-3 shadow-sm", style: "border-radius: 50px; font-weight: 600;" do %>
              <i class="fas fa-wrench me-2"></i>I'm a Garage Admin
            <% end %>
          </div>
          <p class="mt-4 text-muted">
            Already have an account? 
            <%= link_to "Sign in here", new_user_session_path, class: "text-primary fw-semibold text-decoration-none" %>
          </p>
        <% else %>
          <div class="mt-4">
            <p class="h5 text-primary mb-3">Welcome back, <%= current_user.name %>!</p>
            <% if current_user.car_owner? %>
              <%= link_to cars_path, class: "btn btn-lg btn-primary px-5 py-3 shadow-sm me-3", style: "border-radius: 50px; font-weight: 600;" do %>
                <i class="fas fa-car me-2"></i>View My Cars
              <% end %>
              <%= link_to booking_history_path, class: "btn btn-lg btn-outline-primary px-5 py-3 shadow-sm", style: "border-radius: 50px; font-weight: 600;" do %>
                <i class="fas fa-history me-2"></i>Booking History
              <% end %>
            <% elsif current_user.garage_admin? %>
              <%= link_to garages_path, class: "btn btn-lg btn-primary px-5 py-3 shadow-sm", style: "border-radius: 50px; font-weight: 600;" do %>
                <i class="fas fa-wrench me-2"></i>Manage Garage
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>


