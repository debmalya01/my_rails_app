<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
          <i class="fas fa-history me-2"></i>
          Booking History
        </h2>
        <div id="bookingStats" class="text-muted small">
          <!-- Populated by JavaScript -->
        </div>
      </div>
      
      <!-- API-powered view -->
      <div id="bookingHistoryContainer">
        <div class="text-center py-5">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-3">Loading your booking history...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Include the booking history API JavaScript -->
<%= javascript_include_tag "booking_history_api", "data-turbo-track": "reload", defer: true %>

<!-- Add Font Awesome if not already included -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
