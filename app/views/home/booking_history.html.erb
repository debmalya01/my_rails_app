<!-- Hero Section -->
<section class="booking-history-hero py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="display-5 fw-bold mb-3">
          <i class="fas fa-history me-3"></i>
          Your Service History
        </h1>
        <p class="lead mb-0" style="opacity: 0.9;">
          Track all your vehicle service appointments and maintenance records in one place
        </p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <div id="bookingStats" class="stats-card p-3 rounded" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);">
          <div class="d-flex align-items-center justify-content-center">
            <div class="spinner-border spinner-border-sm me-2" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <span>Loading statistics...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Main Content -->
<section class="py-5" style="background: #f8fafc; min-height: 70vh;">
  <div class="container">
    <!-- Quick Actions Bar -->
    <%
=begin%>
 <div class="row mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 15px;">
          <div class="card-body py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
              <div class="d-flex align-items-center mb-2 mb-lg-0">
                
                <div>
                  <small class="text-muted d-block">Quick Actions</small>
                  <span class="fw-semibold">Manage Your Bookings</span>
                </div>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <a href="/cars/new" class="btn btn-primary btn-sm">
                  <i class="fas fa-plus me-1"></i> New Booking
                </a>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                  <i class="fas fa-print me-1"></i> Print
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div> 
<%
=end%>

    <!-- Booking History Container -->
    <div id="bookingHistoryContainer">
      <!-- Enhanced Loading State -->
      <div class="text-center py-5">
        <div class="loading-container mb-4">
          <div class="loading-spinner">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
          <div class="loading-dots mt-3">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
        </div>
        <h4 class="text-muted mb-2">Loading Your Service History</h4>
        <p class="text-muted">Please wait while we fetch your booking records...</p>
      </div>
    </div>
  </div>
</section>

<!-- Include the booking history API JavaScript -->
<%= javascript_include_tag "booking_history_api", "data-turbo-track": "reload", defer: true %>

<!-- Add Bootstrap JS for dropdown functionality -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Add Font Awesome if not already included -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<!-- Custom Styles -->
<style>
  /* Loading Animation */
  .loading-dots {
    display: inline-block;
  }
  
  .loading-dots .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #007bff;
    margin: 0 2px;
    animation: loading-dots 1.4s infinite ease-in-out both;
  }
  
  .loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
  .loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
  
  @keyframes loading-dots {
    0%, 80%, 100% {
      transform: scale(0);
      opacity: 0.5;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Stats Card Animation */
  .stats-card {
    transition: all 0.3s ease;
  }
  
  .stats-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }

  /* Smooth transitions for all cards */
  .card {
    transition: all 0.3s ease;
  }
  
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.1) !important;
  }
  
  /* Custom button styles */
  .btn {
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  
  .btn:hover {
    transform: translateY(-1px);
  }
</style>
