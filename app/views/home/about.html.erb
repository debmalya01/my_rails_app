<!-- Hero Section -->
<section class="py-5 text-center" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); min-height: 50vh; display: flex; align-items: center;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h1 class="display-3 fw-bold text-primary mb-4">About Mechanico</h1>
        <p class="lead text-muted mb-4" style="font-size: 1.3rem; line-height: 1.6;">
          Transforming the automotive service industry through innovative technology and trusted partnerships.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Our Story Section -->
<section class="py-5" style="background: white;">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 text-center">
        <h2 class="display-5 fw-bold text-primary mb-4">Our Story</h2>
        <p class="lead text-muted mb-4">
          Founded with a vision to bridge the gap between car owners and trusted automotive service providers, 
          Mechanico has evolved into a comprehensive platform that simplifies vehicle management.
        </p>
      </div>
    </div>
    
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <div class="p-4">
          <h3 class="fw-bold text-primary mb-3">For Car Owners</h3>
          <p class="text-muted mb-4" style="line-height: 1.6;">
            We understand the challenges of maintaining your vehicle. From finding reliable garages to 
            keeping track of service history, Mechanico provides a seamless solution that puts you in control.
          </p>
          <ul class="list-unstyled">
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Easy service booking</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Digital service history</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Trusted garage network</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Transparent pricing</li>
          </ul>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="p-4">
          <h3 class="fw-bold text-primary mb-3">For Garage Owners</h3>
          <p class="text-muted mb-4" style="line-height: 1.6;">
            We empower garage owners with powerful tools to streamline operations, manage bookings efficiently, 
            and grow their business through our trusted platform.
          </p>
          <ul class="list-unstyled">
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Advanced booking management</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Customer relationship tools</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Business analytics</li>
            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Increased visibility</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mission & Values Section -->
<section class="py-5" style="background: #f8f9fa;">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 text-center">
        <h2 class="display-5 fw-bold text-primary mb-3">Our Mission & Values</h2>
      </div>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <div class="d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: linear-gradient(135deg, #007bff, #0056b3); border-radius: 20px;">
                <i class="fas fa-bullseye fa-2x text-white"></i>
              </div>
            </div>
            <h5 class="card-title fw-bold text-primary mb-3">Our Mission</h5>
            <p class="card-text text-muted" style="line-height: 1.6;">
              To revolutionize automotive service by connecting car owners with trusted garages through innovative technology.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <div class="d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: linear-gradient(135deg, #28a745, #1e7e34); border-radius: 20px;">
                <i class="fas fa-shield-alt fa-2x text-white"></i>
              </div>
            </div>
            <h5 class="card-title fw-bold text-primary mb-3">Trust & Reliability</h5>
            <p class="card-text text-muted" style="line-height: 1.6;">
              We verify all our garage partners and maintain transparent service records to ensure reliability.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 20px;">
          <div class="card-body text-center p-4">
            <div class="mb-3">
              <div class="d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: linear-gradient(135deg, #ffc107, #e0a800); border-radius: 20px;">
                <i class="fas fa-lightbulb fa-2x text-white"></i>
              </div>
            </div>
            <h5 class="card-title fw-bold text-primary mb-3">Innovation</h5>
            <p class="card-text text-muted" style="line-height: 1.6;">
              We continuously evolve our platform with cutting-edge features to enhance user experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Team Section -->
<section class="py-5" style="background: white;">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 text-center">
        <h2 class="display-5 fw-bold text-primary mb-3">Our Commitment</h2>
        <p class="lead text-muted">
          We're dedicated to providing exceptional service and support to both car owners and garage partners.
        </p>
      </div>
    </div>
    
    <div class="row g-4">
      <div class="col-md-6">
        <div class="d-flex align-items-start mb-4">
          <div class="flex-shrink-0 me-3">
            <div class="d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #007bff, #0056b3); border-radius: 15px;">
              <i class="fas fa-users fa-lg text-white"></i>
            </div>
          </div>
          <div class="px-3">
            <h5 class="fw-bold text-primary mb-2">Customer-Centric Approach</h5>
            <p class="text-muted mb-0">
              Every feature and service is designed with our users' needs in mind, ensuring the best possible experience.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="d-flex align-items-start mb-4">
          <div class="flex-shrink-0 me-3">
            <div class="d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #28a745, #1e7e34); border-radius: 15px;">
              <i class="fas fa-clock fa-lg text-white"></i>
            </div>
          </div>
          <div class="px-3">
            <h5 class="fw-bold text-primary mb-2">24/7 Support</h5>
            <p class="text-muted mb-0">
              Our dedicated support team is available around the clock to assist with any questions or concerns.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="d-flex align-items-start mb-4">
          <div class="flex-shrink-0 me-3">
            <div class="d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #ffc107, #e0a800); border-radius: 15px;">
              <i class="fas fa-certificate fa-lg text-white"></i>
            </div>
          </div>
          <div class="px-3">
            <h5 class="fw-bold text-primary mb-2">Quality Assurance</h5>
            <p class="text-muted mb-0">
              We maintain strict quality standards and continuously monitor service quality across our network.
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-md-6">
        <div class="d-flex align-items-start mb-4">
          <div class="flex-shrink-0 me-3">
            <div class="d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #dc3545, #c82333); border-radius: 15px;">
              <i class="fas fa-heart fa-lg text-white"></i>
            </div>
          </div>
          <div class="px-3">
            <h5 class="fw-bold text-primary mb-2">Community Impact</h5>
            <p class="text-muted mb-0">
              We're committed to supporting local businesses and creating positive impact in the automotive industry.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-5" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
  <div class="container">
    <div class="row justify-content-center text-center text-white">
      <div class="col-lg-8">
        <h2 class="display-5 fw-bold mb-3">Ready to Join Us?</h2>
        <p class="lead mb-4" style="opacity: 0.9;">
          Be part of the automotive service revolution. Whether you're a car owner or garage owner, we're here to help.
        </p>
        <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
          <%= link_to root_path, class: "btn btn-light btn-lg px-5 py-3 text-primary fw-bold shadow", style: "border-radius: 50px;" do %>
            <i class="fas fa-home me-2"></i>Back to Home
          <% end %>
          <% unless user_signed_in? %>
            <%= link_to new_user_registration_path, class: "btn btn-outline-light btn-lg px-5 py-3 fw-bold shadow", style: "border-radius: 50px;" do %>
              <i class="fas fa-user-plus me-2"></i>Get Started
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Add Font Awesome if not already included -->
